{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "FamilyCalendar",
    "Audience": "FamilyCalendar.Client",
    "ExpiryMinutes": 60
  },
  "Display": {
    "TimeZoneId": "Asia/Jerusalem"
  },
  "Uploads": {
    "MaxSizeMb": 5,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".pdf", ".docx" ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "From": "",
    "FromName": "לוח אירועים משפחתי",
    "Username": "",
    "TimeoutSeconds": 30
  },
  "Reminders": {
    "Enabled": true,
    "IntervalMinutes": 15
  }
}
