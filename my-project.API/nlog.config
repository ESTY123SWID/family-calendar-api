<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog configuration of the API.
  Every log line goes to the console and to a daily file under my-project.API/logs/.
  The code keeps using ILogger<T>; NLog only decides where the lines are written.
  Never log passwords, tokens or request bodies.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variables>
    <!-- ${currentdir} is the folder the server runs from – the same folder ASP.NET uses as ContentRootPath
         (the project folder in Visual Studio). Unlike ${aspnet-appbasepath}, it is already correct before
         the host exists, so a startup crash is written to the same logs/ folder, not to bin/ -->
    <variable name="logDirectory" value="${currentdir}/logs" />
    <!-- date | level | CorrelationId ("-" outside a request) | class | message | exception (when there is one) -->
    <variable name="lineLayout"
              value="${longdate}|${level:uppercase=true}|${scopeproperty:CorrelationId:whenEmpty=-}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />
    <!-- Our code writes Debug details only in Development (launchSettings.json); elsewhere Information and above -->
    <variable name="appMinLevel"
              value="${when:when='${environment:ASPNETCORE_ENVIRONMENT}' == 'Development':inner=Debug:else=Info}" />
  </variables>

  <targets>
    <target xsi:type="Console" name="console" layout="${lineLayout}" />

    <!-- A new file every day; a file larger than 10 MB rolls over to a numbered one; only the last 14 files are kept -->
    <target xsi:type="File" name="file"
            fileName="${logDirectory}/app-${shortdate}.log"
            layout="${lineLayout}"
            encoding="utf-8"
            archiveAboveSize="10485760"
            maxArchiveFiles="14" />
  </targets>

  <rules>
    <!-- "Now listening on ..." and "Application started" are worth keeping -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />

    <!-- ASP.NET Core and EF Core: only Warning and above (no SQL or routing noise) -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Our code: Debug and above in Development, Information and above elsewhere -->
    <logger name="*" minlevel="${var:appMinLevel}" writeTo="console,file" />
  </rules>
</nlog>
